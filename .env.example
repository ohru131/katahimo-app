# ── データベース ─────────────────────────────────────────────
# ローカルにPostgreSQLを直接入れている場合(既定): ポート5432
DATABASE_URL=postgres://katahimo:katahimo@localhost:5432/katahimo_dev
# infra/docker-compose.yml を使う場合はポート5433
# DATABASE_URL=postgres://katahimo:katahimo@localhost:5433/katahimo_dev

# マイグレーション実行用(テーブル所有者)。未設定なら DATABASE_URL を使う
# MIGRATION_DATABASE_URL=postgres://katahimo:katahimo@localhost:5432/katahimo_dev

# ── サーバー ────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Cookieセッションの署名鍵(本番はSecret Manager)。openssl rand -hex 32 等で生成する
SESSION_SECRET=change-me-in-production

# ── 認証 ────────────────────────────────────────────────────
# GAS版 gas-childcare-visit-app のScript Properties AUTH_SALT と同じ値を入れる。
# 既存スタッフが今のパスワードのままログインできるようにするために必要(移行完了後は不要)。
LEGACY_AUTH_SALT=
# Google認証(OIDC)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# ── Google連携(Phase 5) ─────────────────────────────────────
# サービスアカウントJSON。ローカルはファイルパス、Cloud RunはWorkload Identityで不要
GOOGLE_APPLICATION_CREDENTIALS=
# Google Maps Platform (Geocoding API + Routes API)
GOOGLE_MAPS_API_KEY=
# Gemini API
GEMINI_API_KEY=

# ── 機能フラグ ──────────────────────────────────────────────
# スプレッドシート等へのミラー書き込みを行うか。Sheets脱却時に false にするだけでよい
MIRROR_TO_GOOGLE_SHEETS=false
MIRROR_TO_GOOGLE_CALENDAR=false
